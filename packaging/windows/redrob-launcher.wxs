<?xml version="1.0" encoding="utf-8"?>
<!--
  Redrob Launcher MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util
  extensions: `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`).
  Built by package.ps1:

    wix build redrob-launcher.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc redrob-launcher.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -o out.msi

  Per-user install (no UAC prompt), by default into %LOCALAPPDATA%\Programs\Redrob Launcher, so
  the launcher can update itself without elevation, plus a Start Menu shortcut. The shortcut
  carries the AppUserModelID ai.redrob.launcher, which Windows needs to show toast
  notifications from an unpackaged app and to group the taskbar button. No file associations.

  Double-clicked, it opens a setup wizard that names the version: a language page (English or
  Korean; the rest of the wizard, then the launcher and every Redrob app follow it); Welcome; a
  folder page to pick where it goes, with a "Create a desktop shortcut" box; Ready; a progress
  page; and a Finish page with a ticked "Launch Redrob Launcher" box. There is no licence page (the code is MIT OR
  Apache-2.0; nothing to accept). The install folder and the desktop-shortcut choice are recorded
  under HKCU and reused by later versions, so an update (the launcher's own self-update runs this
  with /passive, which skips the wizard) lands in the same folder and keeps the user's choice; the
  launcher reads the recorded folder to know it was installed by this MSI.

  Per-user packages can't use a file as a component's KeyPath (ICE38), so each component is
  keyed on an HKCU value, and the folders we create are removed on uninstall (ICE64).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Redrob Launcher"
      Manufacturer="Redrob"
      Version="$(var.Version)"
      UpgradeCode="A500A236-9478-4AFE-A413-04028F0BF6EB"
      Scope="perUser"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Redrob Launcher: install and update the Redrob apps" Manufacturer="Redrob" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Redrob Launcher is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename; keep the .exe extension (ICE50). -->
    <Icon Id="RedrobLauncherIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="RedrobLauncherIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://redrob.ai" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/redrob-labs/redrob-launcher/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/redrob-labs/redrob-launcher" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Redrob Launcher" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- An update installs where the user put the previous version (recorded by
         RedrobLauncherApp below; every version since 0.1.0 records it). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKCU" Key="Software\Redrob\Redrob Launcher" Name="InstallDir" Type="raw" />
    </Property>

    <!-- The desktop shortcut: the folder page's box sets INSTALLDESKTOPSHORTCUT to 1. It starts
         ticked on a first install; an update keeps what the user chose last time, and an update
         from a version that never asked (0.1.0, 0.1.1) adds none. A value given on the command
         line (msiexec ... INSTALLDESKTOPSHORTCUT=0 or 1) wins. -->
    <Property Id="PREVIOUSDESKTOPSHORTCUT">
      <RegistrySearch Id="PreviousDesktopShortcut" Root="HKCU" Key="Software\Redrob\Redrob Launcher" Name="DesktopShortcutChoice" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLDESKTOPSHORTCUT AND ((NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT PREVIOUSDESKTOPSHORTCUT) OR PREVIOUSDESKTOPSHORTCUT = &quot;1&quot;)" />
    <!-- Recorded as 1 or 0 (an unticked box leaves the property empty), for the next update. -->
    <SetProperty Id="DESKTOPSHORTCUTCHOICE" Action="RememberNoDesktopShortcut" Value="0" Before="InstallInitialize" Sequence="execute"
        Condition="NOT (INSTALLDESKTOPSHORTCUT = &quot;1&quot;)" />
    <SetProperty Id="DESKTOPSHORTCUTCHOICE" Action="RememberDesktopShortcut" Value="1" Before="InstallInitialize" Sequence="execute"
        Condition="INSTALLDESKTOPSHORTCUT = &quot;1&quot;" />

    <Feature Id="Main" Title="Redrob Launcher" Level="1">
      <ComponentGroupRef Id="RedrobLauncherFiles" />
    </Feature>

    <!-- The language of the wizard, the launcher and then every Redrob app. The first page asks;
         the answer is recorded under HKCU (read by the launcher on its first run, docs/
         shared-language.md, and by the next version's installer so an update keeps it). Before
         the page: the previous install's choice, else Korean on a Korean Windows, else English.
         A value given on the command line (msiexec ... REDROBLANG=ko) wins. -->
    <Property Id="REDROBLANG" Secure="yes">
      <RegistrySearch Id="PreviousLanguage" Root="HKCU" Key="Software\Redrob\Redrob Launcher" Name="Language" Type="raw" />
    </Property>
    <SetProperty Id="REDROBLANG" Action="DefaultLanguageKorean" Value="ko" After="AppSearch" Sequence="first"
        Condition="NOT REDROBLANG AND UserLanguageID = 1042" />
    <SetProperty Id="REDROBLANG" Action="DefaultLanguageEnglish" Value="en" After="AppSearch" Sequence="first"
        Condition="NOT REDROBLANG AND NOT (UserLanguageID = 1042)" />

    <!-- The strings the wizard's pages draw from. English until the language page's Next button
         copies the chosen language's set in (redrob-launcher.en-us.wxl has both). -->
    <Property Id="RedrobL_Next" Value="!(loc.L_Next_en)" />
    <Property Id="RedrobL_Back" Value="!(loc.L_Back_en)" />
    <Property Id="RedrobL_Cancel" Value="!(loc.L_Cancel_en)" />
    <Property Id="RedrobL_Install" Value="!(loc.L_Install_en)" />
    <Property Id="RedrobL_Finish" Value="!(loc.L_Finish_en)" />
    <Property Id="RedrobL_Change" Value="!(loc.L_Change_en)" />
    <Property Id="RedrobL_Yes" Value="!(loc.L_Yes_en)" />
    <Property Id="RedrobL_No" Value="!(loc.L_No_en)" />
    <Property Id="RedrobL_WizardTitle" Value="!(loc.L_WizardTitle_en)" />
    <Property Id="RedrobL_WelcomeTitle" Value="!(loc.L_WelcomeTitle_en)" />
    <Property Id="RedrobL_WelcomeDescription" Value="!(loc.L_WelcomeDescription_en)" />
    <Property Id="RedrobL_DirTitle" Value="!(loc.L_DirTitle_en)" />
    <Property Id="RedrobL_DirDescription" Value="!(loc.L_DirDescription_en)" />
    <Property Id="RedrobL_DirFolderLabel" Value="!(loc.L_DirFolderLabel_en)" />
    <Property Id="RedrobL_DirNote" Value="!(loc.L_DirNote_en)" />
    <Property Id="RedrobL_DesktopShortcut" Value="!(loc.L_DesktopShortcut_en)" />
    <Property Id="RedrobL_ReadyTitle" Value="!(loc.L_ReadyTitle_en)" />
    <Property Id="RedrobL_ReadyDescription" Value="!(loc.L_ReadyDescription_en)" />
    <Property Id="RedrobL_ProgressTitle" Value="!(loc.L_ProgressTitle_en)" />
    <Property Id="RedrobL_ProgressText" Value="!(loc.L_ProgressText_en)" />
    <Property Id="RedrobL_ProgressTitleRemove" Value="!(loc.L_ProgressTitleRemove_en)" />
    <Property Id="RedrobL_ProgressTextRemove" Value="!(loc.L_ProgressTextRemove_en)" />
    <Property Id="RedrobL_ProgressStatus" Value="!(loc.L_ProgressStatus_en)" />
    <Property Id="RedrobL_ExitTitle" Value="!(loc.L_ExitTitle_en)" />
    <Property Id="RedrobL_ExitDescription" Value="!(loc.L_ExitDescription_en)" />
    <Property Id="RedrobL_ExitText" Value="!(loc.L_ExitText_en)" />
    <Property Id="RedrobL_Launch" Value="!(loc.L_Launch_en)" />
    <Property Id="RedrobL_CancelText" Value="!(loc.L_CancelText_en)" />

    <!-- The setup wizard: our own pages (language, welcome, folder with the desktop-shortcut box,
         ready, progress, finish), each drawing its text from the RedrobL_* properties so it speaks
         the chosen language, plus the stock WixUI dialogs for the rare paths (browse for a folder,
         invalid folder, errors, files in use, and the repair/remove wizard an installed copy
         gets). Modelled on WixUI_InstallDir without its licence page. -->
    <UI Id="RedrobUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="InstallDir" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="InvalidDirDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />
      <DialogRef Id="VerifyReadyDlg" />

      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath_$(sys.BUILDARCHSHORT)" Order="1" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="2" Condition="WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />

      <!-- The repair/remove wizard an installed copy gets (stock, English). -->
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="1" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="RedrobInstallDirDlg" Order="2" Condition="NOT Installed" />
      <Property Id="ARPNOMODIFY" Value="1" />

      <InstallUISequence>
        <Show Dialog="RedrobLanguageDlg" Before="RedrobProgressDlg" Condition="NOT Installed" />
        <Show Dialog="RedrobProgressDlg" Before="ExecuteAction" />
        <Show Dialog="RedrobExitDlg" OnExit="success" />
      </InstallUISequence>

      <!-- Page 1: the language. Bilingual, since it comes before the choice. -->
      <Dialog Id="RedrobLanguageDlg" Width="370" Height="270" Title="[ProductName] Setup / 설치">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.L_Next_en) / !(loc.L_Next_ko)">
          <Publish Property="RedrobL_Next" Value="!(loc.L_Next_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_Next" Value="!(loc.L_Next_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_Back" Value="!(loc.L_Back_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_Back" Value="!(loc.L_Back_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_Cancel" Value="!(loc.L_Cancel_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_Cancel" Value="!(loc.L_Cancel_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_Install" Value="!(loc.L_Install_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_Install" Value="!(loc.L_Install_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_Finish" Value="!(loc.L_Finish_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_Finish" Value="!(loc.L_Finish_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_Change" Value="!(loc.L_Change_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_Change" Value="!(loc.L_Change_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_Yes" Value="!(loc.L_Yes_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_Yes" Value="!(loc.L_Yes_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_No" Value="!(loc.L_No_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_No" Value="!(loc.L_No_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_WizardTitle" Value="!(loc.L_WizardTitle_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_WizardTitle" Value="!(loc.L_WizardTitle_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_WelcomeTitle" Value="!(loc.L_WelcomeTitle_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_WelcomeTitle" Value="!(loc.L_WelcomeTitle_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_WelcomeDescription" Value="!(loc.L_WelcomeDescription_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_WelcomeDescription" Value="!(loc.L_WelcomeDescription_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_DirTitle" Value="!(loc.L_DirTitle_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_DirTitle" Value="!(loc.L_DirTitle_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_DirDescription" Value="!(loc.L_DirDescription_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_DirDescription" Value="!(loc.L_DirDescription_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_DirFolderLabel" Value="!(loc.L_DirFolderLabel_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_DirFolderLabel" Value="!(loc.L_DirFolderLabel_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_DirNote" Value="!(loc.L_DirNote_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_DirNote" Value="!(loc.L_DirNote_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_DesktopShortcut" Value="!(loc.L_DesktopShortcut_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_DesktopShortcut" Value="!(loc.L_DesktopShortcut_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_ReadyTitle" Value="!(loc.L_ReadyTitle_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_ReadyTitle" Value="!(loc.L_ReadyTitle_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_ReadyDescription" Value="!(loc.L_ReadyDescription_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_ReadyDescription" Value="!(loc.L_ReadyDescription_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_ProgressTitle" Value="!(loc.L_ProgressTitle_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_ProgressTitle" Value="!(loc.L_ProgressTitle_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_ProgressText" Value="!(loc.L_ProgressText_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_ProgressText" Value="!(loc.L_ProgressText_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_ProgressTitleRemove" Value="!(loc.L_ProgressTitleRemove_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_ProgressTitleRemove" Value="!(loc.L_ProgressTitleRemove_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_ProgressTextRemove" Value="!(loc.L_ProgressTextRemove_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_ProgressTextRemove" Value="!(loc.L_ProgressTextRemove_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_ProgressStatus" Value="!(loc.L_ProgressStatus_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_ProgressStatus" Value="!(loc.L_ProgressStatus_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_ExitTitle" Value="!(loc.L_ExitTitle_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_ExitTitle" Value="!(loc.L_ExitTitle_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_ExitDescription" Value="!(loc.L_ExitDescription_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_ExitDescription" Value="!(loc.L_ExitDescription_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_ExitText" Value="!(loc.L_ExitText_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_ExitText" Value="!(loc.L_ExitText_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_Launch" Value="!(loc.L_Launch_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_Launch" Value="!(loc.L_Launch_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Property="RedrobL_CancelText" Value="!(loc.L_CancelText_ko)" Order="1" Condition="REDROBLANG = &quot;ko&quot;" />
          <Publish Property="RedrobL_CancelText" Value="!(loc.L_CancelText_en)" Order="1" Condition="NOT (REDROBLANG = &quot;ko&quot;)" />
          <Publish Event="NewDialog" Value="RedrobWelcomeDlg" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.L_Cancel_en) / !(loc.L_Cancel_ko)">
          <Publish Event="SpawnDialog" Value="RedrobCancelDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.L_Back_en)" />
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="WixUI_Bmp_Dialog" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}!(loc.L_LanguageTitle)" />
        <Control Id="Description" Type="Text" X="135" Y="62" Width="220" Height="80" Transparent="yes" NoPrefix="yes" Text="!(loc.L_LanguageDescription)" />
        <Control Id="Language" Type="RadioButtonGroup" X="135" Y="150" Width="220" Height="50" Property="REDROBLANG">
          <RadioButtonGroup Property="REDROBLANG">
            <RadioButton Value="en" X="0" Y="0" Width="220" Height="17" Text="!(loc.L_LanguageEnglish)" />
            <RadioButton Value="ko" X="0" Y="22" Width="220" Height="17" Text="!(loc.L_LanguageKorean)" />
          </RadioButtonGroup>
        </Control>
      </Dialog>

      <!-- Page 2: welcome. -->
      <Dialog Id="RedrobWelcomeDlg" Width="370" Height="270" Title="[RedrobL_WizardTitle]">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="[RedrobL_Next]">
          <Publish Event="NewDialog" Value="RedrobInstallDirDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="[RedrobL_Back]">
          <Publish Event="NewDialog" Value="RedrobLanguageDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="[RedrobL_Cancel]">
          <Publish Event="SpawnDialog" Value="RedrobCancelDlg" />
        </Control>
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="WixUI_Bmp_Dialog" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}[RedrobL_WelcomeTitle]" />
        <Control Id="Description" Type="Text" X="135" Y="80" Width="220" Height="90" Transparent="yes" NoPrefix="yes" Text="[RedrobL_WelcomeDescription]" />
      </Dialog>

      <!-- Page 3: the folder, with the desktop-shortcut box. -->
      <Dialog Id="RedrobInstallDirDlg" Width="370" Height="270" Title="[RedrobL_WizardTitle]">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="[RedrobL_Next]">
          <!-- As WixUI_InstallDir does for its own folder page: take the folder, check it, go on. -->
          <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
          <Publish Event="DoAction" Value="WixUIValidatePath_$(sys.BUILDARCHSHORT)" Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />
          <Publish Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
          <Publish Event="NewDialog" Value="RedrobReadyDlg" Order="4" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="[RedrobL_Back]">
          <Publish Event="NewDialog" Value="RedrobWelcomeDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="[RedrobL_Cancel]">
          <Publish Event="SpawnDialog" Value="RedrobCancelDlg" />
        </Control>

        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="[RedrobL_DirDescription]" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}[RedrobL_DirTitle]" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="FolderLabel" Type="Text" X="20" Y="60" Width="290" Height="30" NoPrefix="yes" Text="[RedrobL_DirFolderLabel]" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="100" Width="320" Height="18" Property="WIXUI_INSTALLDIR" Indirect="yes" />
        <Control Id="ChangeFolder" Type="PushButton" X="20" Y="120" Width="56" Height="17" Text="[RedrobL_Change]">
          <Publish Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
          <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2" />
        </Control>
        <Control Id="PerUserNote" Type="Text" X="20" Y="146" Width="330" Height="24" NoPrefix="yes" Text="[RedrobL_DirNote]" />

        <Control Id="DesktopShortcut" Type="CheckBox" X="20" Y="186" Width="330" Height="17" Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="[RedrobL_DesktopShortcut]" />
      </Dialog>

      <!-- Page 4: ready. Per-user, so no elevation shield. -->
      <Dialog Id="RedrobReadyDlg" Width="370" Height="270" Title="[RedrobL_WizardTitle]" TrackDiskSpace="yes">
        <Control Id="Install" Type="PushButton" ElevationShield="no" X="212" Y="243" Width="80" Height="17" Default="yes" Text="[RedrobL_Install]">
          <Publish Event="EndDialog" Value="Return" Condition="OutOfDiskSpace &lt;&gt; 1" />
          <Publish Event="SpawnDialog" Value="OutOfRbDiskDlg" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (PROMPTROLLBACKCOST=&quot;P&quot; OR NOT PROMPTROLLBACKCOST)" />
          <Publish Event="EndDialog" Value="Return" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" />
          <Publish Event="EnableRollback" Value="False" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" />
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Condition="(OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 1) OR (OutOfDiskSpace = 1 AND PROMPTROLLBACKCOST=&quot;F&quot;)" />
        </Control>
        <Control Id="Back" Type="PushButton" X="156" Y="243" Width="56" Height="17" Text="[RedrobL_Back]">
          <Publish Event="NewDialog" Value="RedrobInstallDirDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="[RedrobL_Cancel]">
          <Publish Event="SpawnDialog" Value="RedrobCancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}[RedrobL_ReadyTitle]" />
        <Control Id="Description" Type="Text" X="25" Y="70" Width="320" Height="40" NoPrefix="yes" Text="[RedrobL_ReadyDescription]" />
      </Dialog>

      <!-- Page 5: progress. -->
      <Dialog Id="RedrobProgressDlg" Width="370" Height="270" Title="[RedrobL_WizardTitle]" Modeless="yes">
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="[RedrobL_Cancel]">
          <Publish Event="SpawnDialog" Value="RedrobCancelDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="[RedrobL_Back]" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Disabled="yes" Text="[RedrobL_Next]" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="TextInstalling" Type="Text" X="20" Y="65" Width="330" Height="35" Hidden="yes" NoPrefix="yes" Text="[RedrobL_ProgressText]" ShowCondition="NOT (WixUI_InstallMode = &quot;Remove&quot;)" />
        <Control Id="TitleInstalling" Type="Text" X="20" Y="15" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\WixUI_Font_Title}[RedrobL_ProgressTitle]" ShowCondition="NOT (WixUI_InstallMode = &quot;Remove&quot;)" />
        <Control Id="TextRemoving" Type="Text" X="20" Y="65" Width="330" Height="35" Hidden="yes" NoPrefix="yes" Text="[RedrobL_ProgressTextRemove]" ShowCondition="WixUI_InstallMode = &quot;Remove&quot;" />
        <Control Id="TitleRemoving" Type="Text" X="20" Y="15" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\WixUI_Font_Title}[RedrobL_ProgressTitleRemove]" ShowCondition="WixUI_InstallMode = &quot;Remove&quot;" />
        <Control Id="ActionText" Type="Text" X="70" Y="100" Width="285" Height="10">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="115" Width="330" Height="10" ProgressBlocks="yes" Text="Progress done">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="StatusLabel" Type="Text" X="20" Y="100" Width="50" Height="10" Text="[RedrobL_ProgressStatus]" />
      </Dialog>

      <!-- Page 6: finish, with the "launch" box ticked. -->
      <Dialog Id="RedrobExitDlg" Width="370" Height="270" Title="[RedrobL_WizardTitle]">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="[RedrobL_Finish]">
          <Publish Event="DoAction" Value="LaunchRedrobLauncher" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
          <Publish Event="EndDialog" Value="Return" Order="999" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="[RedrobL_Cancel]" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="[RedrobL_Back]" />
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="WixUI_Bmp_Dialog" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}[RedrobL_ExitTitle]" />
        <Control Id="Description" Type="Text" X="135" Y="80" Width="220" Height="20" Transparent="yes" NoPrefix="yes" Text="[RedrobL_ExitDescription]" />
        <Control Id="OptionalText" Type="Text" X="135" Y="110" Width="220" Height="80" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[RedrobL_ExitText]" ShowCondition="NOT Installed" />
        <Control Id="OptionalCheckBox" Type="CheckBox" X="135" Y="190" Width="220" Height="40" Hidden="yes" Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX" CheckBoxValue="1" Text="[RedrobL_Launch]" ShowCondition="NOT Installed" />
      </Dialog>

      <!-- "Cancel?" in the chosen language. -->
      <Dialog Id="RedrobCancelDlg" Width="260" Height="85" Title="[RedrobL_WizardTitle]">
        <Control Id="No" Type="PushButton" X="132" Y="57" Width="56" Height="17" Default="yes" Cancel="yes" Text="[RedrobL_No]">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Yes" Type="PushButton" X="72" Y="57" Width="56" Height="17" Text="[RedrobL_Yes]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="Text" Type="Text" X="48" Y="15" Width="194" Height="30" NoPrefix="yes" Text="[RedrobL_CancelText]" />
        <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24" FixedSize="yes" IconSize="32" Text="WixUI_Ico_Info" />
      </Dialog>
    </UI>
    <UIRef Id="WixUI_Common" />
    <!-- The folder page edits this; WixUI_Common's path validation reads it. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Our own art, drawn by package.ps1 from the Redrob mark and the Redrob apps' icons. -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through the RedrobL_* strings. -->
    <Property Id="RedrobLauncherVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: the "launch" box starts ticked. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#RedrobLauncherExe]" />
    <!-- Runs in the wizard's own process, so the launcher starts as the user. -->
    <CustomAction Id="LaunchRedrobLauncher" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="RedrobLauncherFiles">
      <Component Id="RedrobLauncherApp" Directory="INSTALLFOLDER" Guid="1AE663ED-0841-4E13-ACE3-11A21F71E9BD">
        <File Id="RedrobLauncherExe" Source="$(var.BinDir)\redrob-launcher.exe" KeyPath="no" />
        <!-- Read back by the next version's installer and by the launcher (self_update.rs). -->
        <RegistryValue Root="HKCU" Key="Software\Redrob\Redrob Launcher" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Redrob\Redrob Launcher" Name="DesktopShortcutChoice" Value="[DESKTOPSHORTCUTCHOICE]" Type="string" />
        <!-- The language chosen on the wizard's first page (en, ko): the launcher adopts it on its
             first run and publishes it for every Redrob app (docs/shared-language.md). -->
        <RegistryValue Root="HKCU" Key="Software\Redrob\Redrob Launcher" Name="Language" Value="[REDROBLANG]" Type="string" />
        <!-- Win+R "redrob-launcher". -->
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\redrob-launcher.exe" Value="[#RedrobLauncherExe]" Type="string" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveLocalProgramsFolder" Directory="LocalProgramsFolder" On="uninstall" />
      </Component>

      <Component Id="RedrobLauncherShortcut" Directory="ProgramMenuFolder" Guid="4C0FE407-84FC-4913-A831-03713B8D702E">
        <Shortcut Id="StartMenuShortcut" Name="Redrob Launcher"
            Description="Install and update the Redrob apps"
            Target="[#RedrobLauncherExe]" WorkingDirectory="INSTALLFOLDER"
            Icon="RedrobLauncherIcon.exe" IconIndex="0">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="ai.redrob.launcher" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Redrob\Redrob Launcher" Name="StartMenuShortcut" Value="1" Type="integer" KeyPath="yes" />
      </Component>

      <!-- Only when the folder page's box is ticked; removed on uninstall like everything else. -->
      <Component Id="RedrobLauncherDesktopShortcut" Directory="DesktopFolder" Guid="C782BB36-CBE2-4D04-A03B-61EAC2964D84"
          Condition="INSTALLDESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="Redrob Launcher"
            Description="Install and update the Redrob apps"
            Target="[#RedrobLauncherExe]" WorkingDirectory="INSTALLFOLDER"
            Icon="RedrobLauncherIcon.exe" IconIndex="0">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="ai.redrob.launcher" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Redrob\Redrob Launcher" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
