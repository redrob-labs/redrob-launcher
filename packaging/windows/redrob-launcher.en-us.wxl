<?xml version="1.0" encoding="utf-8"?>
<!--
  Every string the setup wizard shows, in English (L_*_en) and Korean (L_*_ko). The wizard's first
  page asks which language to use; its Next button copies the chosen set into the RedrobL_*
  properties the later pages draw from (redrob-launcher.wxs), so one MSI speaks both languages.
  Korean needs a code page that holds Hangul: 949 (the Korean Windows code page) covers ASCII too,
  so the English strings are unaffected.

  [RedrobLauncherVersion] is the full version, pre-release tag included; [ProductName] is
  "Redrob Launcher". Product and app names stay in Latin script in both languages.
-->
<WixLocalization Culture="en-US" Codepage="949" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <!-- The language page itself is bilingual: it is shown before the choice is made. -->
  <String Id="L_LanguageTitle" Value="Choose your language / 언어를 선택하세요" />
  <String Id="L_LanguageDescription" Value="The setup wizard, Redrob Launcher and the Redrob apps will use this language. You can change it later in the launcher's settings.&#13;&#10;&#13;&#10;설치 과정, Redrob Launcher, Redrob 앱이 이 언어를 씁니다. 나중에 런처 설정에서 바꿀 수 있습니다." />
  <String Id="L_LanguageEnglish" Value="English" />
  <String Id="L_LanguageKorean" Value="한국어 (Korean)" />

  <!-- Buttons. -->
  <String Id="L_Next_en" Value="&amp;Next" />
  <String Id="L_Next_ko" Value="다음(&amp;N)" />
  <String Id="L_Back_en" Value="&amp;Back" />
  <String Id="L_Back_ko" Value="뒤로(&amp;B)" />
  <String Id="L_Cancel_en" Value="Cancel" />
  <String Id="L_Cancel_ko" Value="취소" />
  <String Id="L_Install_en" Value="&amp;Install" />
  <String Id="L_Install_ko" Value="설치(&amp;I)" />
  <String Id="L_Finish_en" Value="&amp;Finish" />
  <String Id="L_Finish_ko" Value="마침(&amp;F)" />
  <String Id="L_Change_en" Value="&amp;Change..." />
  <String Id="L_Change_ko" Value="변경(&amp;C)..." />
  <String Id="L_Yes_en" Value="&amp;Yes" />
  <String Id="L_Yes_ko" Value="예(&amp;Y)" />
  <String Id="L_No_en" Value="&amp;No" />
  <String Id="L_No_ko" Value="아니요(&amp;N)" />

  <!-- Window title. -->
  <String Id="L_WizardTitle_en" Value="[ProductName] Setup" />
  <String Id="L_WizardTitle_ko" Value="[ProductName] 설치" />

  <!-- Welcome page. -->
  <String Id="L_WelcomeTitle_en" Value="Welcome to [ProductName] [RedrobLauncherVersion]" />
  <String Id="L_WelcomeTitle_ko" Value="[ProductName] [RedrobLauncherVersion] 설치를 시작합니다" />
  <String Id="L_WelcomeDescription_en" Value="Redrob Launcher installs, updates and opens the Redrob apps: Redrob Code, Canvas, Film, Shape and the rest.&#13;&#10;&#13;&#10;It installs for you only, so no administrator rights are needed. Click Next to continue." />
  <String Id="L_WelcomeDescription_ko" Value="Redrob Launcher는 Redrob 앱(Redrob Code, Canvas, Film, Shape 등)을 설치하고 업데이트하고 실행합니다.&#13;&#10;&#13;&#10;현재 사용자에게만 설치되므로 관리자 권한이 필요하지 않습니다. 계속하려면 다음을 누르세요." />

  <!-- Folder page. -->
  <String Id="L_DirTitle_en" Value="Choose where to install" />
  <String Id="L_DirTitle_ko" Value="설치 위치 선택" />
  <String Id="L_DirDescription_en" Value="Click Next to install to the default folder, or click Change to pick another." />
  <String Id="L_DirDescription_ko" Value="기본 폴더에 설치하려면 다음을, 다른 폴더를 고르려면 변경을 누르세요." />
  <String Id="L_DirFolderLabel_en" Value="Install [ProductName] to:" />
  <String Id="L_DirFolderLabel_ko" Value="[ProductName] 설치 폴더:" />
  <String Id="L_DirNote_en" Value="Redrob Launcher installs for you only, without administrator rights, so pick a folder you can write to (not Program Files). Updates install into the same folder." />
  <String Id="L_DirNote_ko" Value="Redrob Launcher는 관리자 권한 없이 현재 사용자에게만 설치되므로 쓸 수 있는 폴더를 고르세요(Program Files 제외). 업데이트도 같은 폴더에 설치됩니다." />
  <String Id="L_DesktopShortcut_en" Value="Create a desktop shortcut" />
  <String Id="L_DesktopShortcut_ko" Value="바탕 화면에 바로 가기 만들기" />

  <!-- Ready page. -->
  <String Id="L_ReadyTitle_en" Value="Ready to install [ProductName] [RedrobLauncherVersion]" />
  <String Id="L_ReadyTitle_ko" Value="[ProductName] [RedrobLauncherVersion] 설치 준비 완료" />
  <String Id="L_ReadyDescription_en" Value="Click Install to begin. Click Back to review or change any setting, or Cancel to exit." />
  <String Id="L_ReadyDescription_ko" Value="설치를 시작하려면 설치를 누르세요. 설정을 다시 보거나 바꾸려면 뒤로, 그만두려면 취소를 누르세요." />

  <!-- Progress page (installing; removing when run from Apps &amp; features with UI). -->
  <String Id="L_ProgressTitle_en" Value="Installing [ProductName]" />
  <String Id="L_ProgressTitle_ko" Value="[ProductName] 설치 중" />
  <String Id="L_ProgressText_en" Value="Please wait while the Setup Wizard installs [ProductName]. This may take a few seconds." />
  <String Id="L_ProgressText_ko" Value="[ProductName]을(를) 설치하는 동안 잠시 기다려 주세요. 몇 초 정도 걸립니다." />
  <String Id="L_ProgressTitleRemove_en" Value="Removing [ProductName]" />
  <String Id="L_ProgressTitleRemove_ko" Value="[ProductName] 제거 중" />
  <String Id="L_ProgressTextRemove_en" Value="Please wait while the Setup Wizard removes [ProductName]." />
  <String Id="L_ProgressTextRemove_ko" Value="[ProductName]을(를) 제거하는 동안 잠시 기다려 주세요." />
  <String Id="L_ProgressStatus_en" Value="Status:" />
  <String Id="L_ProgressStatus_ko" Value="상태:" />

  <!-- Finish page. -->
  <String Id="L_ExitTitle_en" Value="Completed the [ProductName] [RedrobLauncherVersion] Setup Wizard" />
  <String Id="L_ExitTitle_ko" Value="[ProductName] [RedrobLauncherVersion] 설치를 마쳤습니다" />
  <String Id="L_ExitDescription_en" Value="Click Finish to exit the Setup Wizard." />
  <String Id="L_ExitDescription_ko" Value="마침을 누르면 설치 마법사가 닫힙니다." />
  <String Id="L_ExitText_en" Value="Redrob Launcher [RedrobLauncherVersion] is installed. Start it any time from the Start menu to install and update the Redrob apps." />
  <String Id="L_ExitText_ko" Value="Redrob Launcher [RedrobLauncherVersion]을(를) 설치했습니다. 시작 메뉴에서 언제든 실행해 Redrob 앱을 설치하고 업데이트하세요." />
  <String Id="L_Launch_en" Value="Launch Redrob Launcher" />
  <String Id="L_Launch_ko" Value="Redrob Launcher 실행" />

  <!-- Cancel confirmation. -->
  <String Id="L_CancelText_en" Value="Are you sure you want to cancel [ProductName] installation?" />
  <String Id="L_CancelText_ko" Value="[ProductName] 설치를 취소할까요?" />
</WixLocalization>
