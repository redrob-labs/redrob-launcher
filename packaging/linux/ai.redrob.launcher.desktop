[Desktop Entry]
Type=Application
Name=Redrob Launcher
GenericName=App Launcher
Comment=Install, update and launch the Redrob apps
Exec=redrob-launcher %u
TryExec=redrob-launcher
Icon=ai.redrob.launcher
Terminal=false
StartupNotify=true
StartupWMClass=redrob-launcher
Categories=Utility;PackageManager;
MimeType=x-scheme-handler/redrob-launcher;x-scheme-handler/redrob;
Keywords=redrob;launcher;installer;updater;apps;
