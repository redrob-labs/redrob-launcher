<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres). Template: package.sh substitutes @VERSION@ and
     @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>ai.redrob.launcher</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Redrob Launcher</name>
  <summary>Install, update and launch the Redrob apps</summary>
  <developer id="ai.redrob">
    <name>Redrob</name>
  </developer>
  <description>
    <p>
      Redrob Launcher lists every Redrob app (Cut, Shape, CAD, Canvas, Design, Studio, Browser,
      Code, IDE, Cowork, Office, Query and Recall), installs the right build for your computer,
      and keeps them up to date.
    </p>
    <ul>
      <li>One place to find, install and open every Redrob app</li>
      <li>Checks GitHub releases for updates and installs them for you</li>
      <li>Lives in the system tray and tells you when updates are ready</li>
    </ul>
  </description>
  <launchable type="desktop-id">ai.redrob.launcher.desktop</launchable>
  <icon type="stock">ai.redrob.launcher</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://redrob.ai</url>
  <url type="bugtracker">https://github.com/redrob-labs/redrob-launcher/issues</url>
  <url type="help">https://github.com/redrob-labs/redrob-launcher</url>
  <categories>
    <category>Utility</category>
    <category>PackageManager</category>
  </categories>
  <keywords>
    <keyword>launcher</keyword>
    <keyword>installer</keyword>
    <keyword>updater</keyword>
    <keyword>redrob</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#eef4ff</color>
    <color type="primary" scheme_preference="dark">#0a0b0c</color>
  </branding>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>redrob-launcher</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
