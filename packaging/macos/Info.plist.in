<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@.
     Redrob Launcher opens no documents, so there are no document or UT types; it does handle
     redrob-launcher:// and redrob:// URLs (CFBundleURLTypes). It is a normal
     Dock app that can also sit in the menu bar: LSUIElement must stay unset. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Redrob Launcher</string>
  <key>CFBundleName</key>
  <string>Redrob Launcher</string>
  <key>CFBundleExecutable</key>
  <string>Redrob Launcher</string>
  <key>CFBundleIdentifier</key>
  <string>ai.redrob.launcher</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>RedrobLauncherVersion</key>
  <string>@VERSION@</string>
  <key>RedrobLauncherBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>Redrob Launcher</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.utilities</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © 2026 Redrob Team and the Redrob Launcher contributors. MIT OR Apache-2.0.</string>
  <!-- redrob-launcher:// and redrob:// links from web pages (docs/deep-links.md). macOS delivers them as a kAEGetURL
       Apple Event, not as an argument: url_scheme.rs installs the handler. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>ai.redrob.launcher</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>redrob-launcher</string>
        <string>redrob</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
